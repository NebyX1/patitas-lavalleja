---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import PetProfile from '../../components/profile/PetProfile.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import Icon from '../../components/ui/Icon.astro';
import { petUrl, site, photoFor } from '../../config/site';
import { serverPet } from '../../lib/server';
import { ApiError } from '../../lib/api';
let pet = null;
let error = '';
try {
  pet = await serverPet(Astro.params.id ?? '');
} catch (failure) {
  Astro.response.status =
    failure instanceof ApiError && failure.status === 404 ? 404 : 503;
  error =
    failure instanceof Error
      ? failure.message
      : 'No pudimos consultar este perfil.';
}
Astro.response.headers.set('Cache-Control', 'no-store');
---

<BaseLayout
  title={
    pet
      ? `Conocé a ${pet.name} · ${pet.age} · ${pet.location}`
      : Astro.response.status === 404
        ? 'Perfil no encontrado'
        : 'Perfil temporalmente no disponible'
  }
  description={
    pet
      ? `${pet.name}: ${pet.quote} ${pet.age}, ${pet.location}. ${pet.is_demo ? 'Perfil ficticio de demostración.' : pet.needs}`
      : error
  }
  noindex={!pet || pet.is_demo}
  image={pet ? photoFor(pet) : undefined}
>
  {pet ? (
    <>
      <StructuredData
        slot="head"
        data={{
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [
            {
              '@type': 'ListItem',
              position: 1,
              name: 'Inicio',
              item: site.url,
            },
            {
              '@type': 'ListItem',
              position: 2,
              name: 'Historias por conocer',
              item: `${site.url}/adopcion/`,
            },
            {
              '@type': 'ListItem',
              position: 3,
              name: pet.name,
              item: `${site.url}${petUrl(pet.id)}`,
            },
          ],
        }}
      />
      <div class="wrap profile-container">
        <div class="profile-topbar">
          <nav class="breadcrumbs" aria-label="Ruta de navegación">
            <a href="/">Inicio</a>
            <span aria-hidden="true">/</span>
            <a href="/adopcion/">Todas las patitas</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{pet.name}</span>
          </nav>
          <a
            class="btn btn-outline btn-small profile-back"
            href="/adopcion/"
            data-profile-back
          >
            <Icon name="left" class="icon-sm" />
            Volver a la búsqueda
          </a>
        </div>
        <PetProfile {pet} />
      </div>
    </>
  ) : (
    <section class="prose-page wrap">
      <div class="eyebrow">Cada historia merece su tiempo</div>
      <h1>
        {Astro.response.status === 404
          ? 'Esta historia no está publicada.'
          : 'Necesitamos un momento.'}
      </h1>
      <p>{error}</p>
      <a class="btn btn-orange" href="/adopcion/">
        Volver al catálogo
      </a>
    </section>
  )}
</BaseLayout>
