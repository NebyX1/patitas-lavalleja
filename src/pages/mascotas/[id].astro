---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PetProfile from '../../components/profile/PetProfile.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import { pets } from '../../data/pets';
import { petUrl, site } from '../../config/site';
import type { Pet } from '../../types/pet';
export function getStaticPaths() {
  return pets.map((pet) => ({ params: { id: pet.id }, props: { pet } }));
}
interface Props {
  pet: Pet;
}
const { pet } = Astro.props;
---

<BaseLayout
  title={`Conocé a ${pet.name} · ${pet.age} · ${pet.location}`}
  description={`${pet.name}: ${pet.quote} ${pet.age}, tamaño ${pet.size.toLowerCase()}, ${pet.location}. Perfil ficticio de demostración para explorar la adopción responsable.`}
>
  <StructuredData
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Historias por conocer',
          item: `${site.url}/adopcion/`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: pet.name,
          item: `${site.url}${petUrl(pet.id)}`,
        },
      ],
    }}
  />
  <div class="wrap profile-container">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/adopcion/">Todas las patitas</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{pet.name}</span>
    </nav>
    <PetProfile {pet} />
  </div>
</BaseLayout>
