---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Esta patita se fue por otro camino" noindex>
  <section class="not-found wrap">
    <div class="eyebrow">
      <span class="dot"></span>Error 404
    </div>
    <h1>
      Esta patita se fue
      <br />
      por otro camino.
    </h1>
    <p>
      La página que buscás no está acá. Hay muchas historias esperando que las
      descubras.
    </p>
    <a class="btn btn-orange" href="/adopcion/">
      Volver a las patitas ↗
    </a>
  </section>
</BaseLayout>
