---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoForm from '../../components/islands/DemoForm';
import { pets } from '../../data/pets';
import type { Pet } from '../../types/pet';
import { petPhoto, petUrl } from '../../config/site';
export function getStaticPaths() {
  return pets.map((pet) => ({ params: { id: pet.id }, props: { pet } }));
}
interface Props {
  pet: Pet;
}
const { pet } = Astro.props;
---

<BaseLayout title={`Quiero conocer a ${pet.name}`} noindex>
  <section class="flow-page wrap">
    <div class="flow-heading">
      <div class="eyebrow">
        <span class="dot"></span>El primer hola
      </div>
      <h1>
        ¿Le decimos
        <br />
        hola a <span>{pet.name}?</span>
      </h1>
      <p>
        Este sería el primer contacto para conocer su mundo y conversar sobre
        una posible adopción.
      </p>
      <a class="request-pet" href={petUrl(pet.id)}>
        <img
          src={petPhoto(pet.id, 480)}
          alt={pet.alt}
          width="480"
          height="480"
        />
        <span>
          <strong>{pet.name}</strong>
          <small>
            {pet.age} · {pet.location}
          </small>
          <small>Volver a su historia ↗</small>
        </span>
      </a>
    </div>
    <DemoForm kind="adoption" petName={pet.name} client:load />
  </section>
</BaseLayout>
