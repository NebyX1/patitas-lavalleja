<section class="match-section wrap reveal" aria-labelledby="match-title">
  <div class="match-block">
    <div class="match-copy">
      <div class="eyebrow">
        <svg class="icon icon-sm">
          <use href="#i-spark" />
        </svg>{' '}
        La conexión va mucho más allá de una foto
      </div>
      <h2 id="match-title" data-split>
        El mejor match
        <br />
        no se mide en likes.
      </h2>
      <p>
        ¿Paseos largos o tardes tranquilas? Contanos un poquito de vos y
        descubrí patitas que podrían ir con tu mundo.
      </p>
      <a class="btn btn-dark" href="/tu-match/">
        Descubrí quién va con vos{' '}
        <svg class="icon icon-sm">
          <use href="#i-arrow-up" />
        </svg>
      </a>
    </div>
    <div class="match-art" aria-hidden="true" data-depth-scope>
      <div class="match-orbit" data-parallax="-0.12"></div>
      <div class="match-photo one" data-depth="10">
        <img
          src="/images/pets/luna-960.webp"
          width="960"
          height="960"
          alt=""
          loading="lazy"
        />
      </div>
      <div class="match-photo two" data-depth="16">
        <img
          src="/images/pets/olivia-960.webp"
          width="960"
          height="960"
          alt=""
          loading="lazy"
        />
      </div>
      <span class="match-center">
        <svg class="icon">
          <use href="#i-heart" />
        </svg>
      </span>
      <span class="match-chip a" data-depth="12">
        <svg class="icon">
          <use href="#i-sun" />
        </svg>{' '}
        Tu ritmo, su energía
      </span>
      <span class="match-chip b" data-depth="18">
        <svg class="icon">
          <use href="#i-home" />
        </svg>{' '}
        Un hogar para compartir
      </span>
      <svg class="icon match-spark">
        <use href="#i-star" />
      </svg>
      <small>
        7 pasos para descubrir afinidades y condiciones por confirmar.
      </small>
    </div>
  </div>
</section>
