---
import PetCatalog from '../islands/PetCatalog';
import { serverPets } from '../../lib/server';
interface Props {
  favoritesOnly?: boolean;
  standalone?: boolean;
}
const { favoritesOnly = false, standalone = false } = Astro.props;
const Heading = standalone ? 'h1' : 'h2';
let initialPage = null;
let initialError = '';
if (!favoritesOnly && !Astro.isPrerendered) {
  try {
    initialPage = await serverPets('page=1&page_size=12');
  } catch (error) {
    initialError =
      error instanceof Error
        ? error.message
        : 'No pudimos consultar el catálogo.';
  }
}
---

<section class="catalog wrap" id="adopcion" aria-labelledby="catalog-title">
  <div class="section-heading reveal">
    <div>
      <div class="eyebrow">
        <span class="dot"></span>
        {favoritesOnly
          ? 'Un lugar para tus historias favoritas'
          : 'Pequeñas personalidades, grandes compañeros'}
      </div>
      <Heading id="catalog-title" data-split>
        {favoritesOnly ? (
          'Las patitas que te robaron el corazón.'
        ) : (
          <>
            No buscan mucho.
            <br />
            Solo a alguien como vos.
          </>
        )}
      </Heading>
    </div>
    <p>
      {favoritesOnly ? (
        'Guardadas en tu cuenta o en este navegador, para volver a encontrarlas.'
      ) : (
        <>
          Cada patita tiene su manera de querer.
          <br />
          Conocé su historia, no solo su foto.
        </>
      )}
    </p>
  </div>
  <PetCatalog
    favoritesOnly={favoritesOnly}
    {initialPage}
    {initialError}
    client:load
  />
  <noscript>
    <p class="demo-notice">
      Podés abrir todas las fichas sin JavaScript. Los filtros y favoritos
      necesitan JavaScript.
    </p>
  </noscript>
</section>
