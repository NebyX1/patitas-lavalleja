# Astro en desarrollo usa el proxy del mismo origen. No agregar /api al final.
BACKEND_INTERNAL_URL=http://127.0.0.1:8010

# Docker/Coolify: generar la clave con python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ENVIRONMENT=production
PUBLIC_SITE_URL=https://patitas.lavalleja.uy
COOKIE_SECURE=true
CORS_ORIGINS=https://patitas.lavalleja.uy
AI_ENABLED=true
RERANK_ENABLED=true
EMBEDDING_BACKEND=openvino
AI_THREADS=2
RERANK_POOL_SIZE=12
MODEL_LOAD_TIMEOUT=120
PUBLIC_DATA_CONTROLLER_NAME=
PUBLIC_PRIVACY_CONTACT=

# Recuperación de contraseña: configurar un servidor autorizado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_STARTTLS=true
